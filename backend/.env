# Copy to backend/.env and adjust. Every value has a sensible default for local development.

# PostgreSQL connection (SQLAlchemy URL using the psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://placematrix:placematrix@localhost:5432/placematrix

# Signs session tokens (JWT). Use a long random string in production.
SECRET_KEY=change-me-in-production-placematrix-secret
TOKEN_TTL_HOURS=12

# Only this email domain can sign in or be invited.
ALLOWED_EMAIL_DOMAIN=iitrpr.ac.in

# Demo mode: one-click demo logins, account switching and "Reset demo data". Set false in production.
DEMO_MODE=false
DEMO_PASSWORD=demo123

# Where uploaded documents are stored, and the per-file limit.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Frontend origin(s) allowed by CORS, and the URL used inside invitation activation links.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Optional: Google Sign-In (OAuth client ID of type "Web application"). Leave empty to hide the button.
GOOGLE_CLIENT_ID=373675020910-887l63u4ns3pvo35n7593tusimma6r9t.apps.googleusercontent.com

# Optional: SMTP relay for invitation emails. Without it, CCPC copies activation links from the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cdpc@iitrpr.ac.in
INVITE_TTL_DAYS=14

# Graduation batch assigned to newly onboarded students (they can edit it in Profile Audit).
DEFAULT_GRAD_YEAR=2026
