# Copy to backend/.env and adjust. Every value has a sensible default for local development.

# PostgreSQL connection (SQLAlchemy URL using the psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://placematrix:placematrix@localhost:5432/placematrix

# Signs session tokens (JWT). Use a long random string in production.
SECRET_KEY=change-me-in-production-placematrix-secret
TOKEN_TTL_HOURS=12

# Only this email domain can sign in or be invited.
ALLOWED_EMAIL_DOMAIN=iitrpr.ac.in

# Demo mode: one-click demo logins, account switching and "Reset demo data". Set false in production.
DEMO_MODE=true
DEMO_PASSWORD=demo123

# Where uploaded documents are stored, and the per-file limit.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Frontend origin(s) allowed by CORS, and the URL used inside invitation activation links.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Optional: Google Sign-In (OAuth client ID of type "Web application"). Leave empty to hide the button.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Email (SMTP) — used for placement invitations, custom emails to students,
# onboarding links and SPOC/verifier assignment notices.
# Leave SMTP_HOST empty to switch email off (the Email Center then shows
# "Not configured" and CCPC copies onboarding links from the UI instead).
# Step-by-step Gmail setup: see PLACEMATRIX_FEATURE_SETUP_GUIDE.txt, part C.
# NEVER commit real credentials — this file is only on your machine.
# ---------------------------------------------------------------------------
# Server address and port. Gmail: smtp.gmail.com and 587 (or 465 with SMTP_SECURITY=ssl).
SMTP_HOST=
SMTP_PORT=587
# Encryption: starttls (port 587), ssl (port 465) or none (local test server only).
# Leave empty to choose automatically: port 465 -> ssl, any other port -> starttls.
# (SMTP_TLS=true/false and SMTP_SSL=true/false are also understood.)
SMTP_SECURITY=
# Login for the SMTP server. Gmail: your full Gmail address + a 16-character App Password.
SMTP_USERNAME=
SMTP_PASSWORD=
# Address and display name students see in the "From" field.
# Gmail only allows your own address (or a verified alias) here.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CDPC IIT Ropar — PlaceMatrix
# Seconds to wait for the SMTP server before reporting a failure.
SMTP_TIMEOUT=20
# Largest number of recipients in one send.
EMAIL_MAX_RECIPIENTS=200
INVITE_TTL_DAYS=14

# ---------------------------------------------------------------------------
# Resumes, database migrations and live sync
# ---------------------------------------------------------------------------
# Maximum number of resumes a student can keep in their library.
MAX_RESUMES=10
# Apply pending database migrations automatically when the backend starts
# (safe: migrations only add tables/columns and never delete data).
AUTO_MIGRATE=true
# Push direct database edits (psql, pgAdmin) to open browsers within ~3 seconds.
REALTIME_SYNC=true

# Graduation batch assigned to newly onboarded students (they can edit it in Profile Audit).
DEFAULT_GRAD_YEAR=2026
