# Copy this file to .env and configure these values before running.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./placematrix.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated IIT Ropar accounts allowed to administer the portal.
# All other verified @iitrpr.ac.in accounts get the STUDENT role.
CCPC_EMAILS=ccpc.name@iitrpr.ac.in
VERIFIER_EMAILS=faculty.name@iitrpr.ac.in
SPOC_EMAILS=spoc.name@iitrpr.ac.in
